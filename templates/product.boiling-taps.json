        "tile_swatches_custom": {
          "type": "custom_swatches",
          "settings": {
            "title": "Colour Swatches",
            "liquid": "<style>\n.tp-tap-picker { margin: 1.5rem 0; padding: 1.375rem 0; border-top: 1px solid #ececec; border-bottom: 1px solid #ececec; }\n.tp-tap-picker > * + * { margin-top: 1.375rem; }\n.tp-tap-picker__label { display: flex; align-items: baseline; gap: .4rem; margin-bottom: .875rem; font-size: .9375rem; line-height: 1.4; }\n.tp-tap-picker__label strong { font-weight: 700; color: #111; }\n.tp-tap-picker__label span { font-weight: 400; color: #555; }\n.tp-tap-swatches { display: flex; flex-wrap: wrap; gap: .75rem; list-style: none; margin: 0; padding: 0; }\n.tp-tap-swatch { display: block; width: 34px; height: 34px; border-radius: 50%; padding: 3px; box-shadow: inset 0 0 0 1px #e3e3e3; transition: box-shadow .18s ease; }\n.tp-tap-swatch span { display: block; width: 100%; height: 100%; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }\n.tp-tap-swatch:hover { box-shadow: inset 0 0 0 1px #9a9a9a; }\n.tp-tap-swatch.is-current { box-shadow: inset 0 0 0 2px #111; }\n.tp-tap-type { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }\n.tp-tap-type label { font-size: .9375rem; font-weight: 700; color: #111; margin: 0; }\n.tp-tap-type__wrap { position: relative; flex: 1 1 240px; max-width: 360px; }\n.tp-tap-type select { width: 100%; min-height: 46px; padding: .6rem 2.4rem .6rem .9rem; border: 2px solid #e6e6e6; border-radius: 4px; font-size: .9375rem; color: #111; background: #fff; -webkit-appearance: none; appearance: none; cursor: pointer; }\n.tp-tap-type select:focus { outline: none; border-color: #016FD0; }\n.tp-tap-type__wrap::after { content: ''; position: absolute; right: 14px; top: 50%; width: 8px; height: 8px; margin-top: -6px; border-right: 2px solid #555; border-bottom: 2px solid #555; transform: rotate(45deg); pointer-events: none; }\n@media (max-width: 480px) { .tp-tap-type__wrap { max-width: none; } }\n</style>\n\n{%- comment -%}\n  TAP TYPE PICKER\n  Uses the same range data as the tile picker: custom.range, custom.colour_name, custom.colour_hex, custom.size_name.\n  1. Colour swatches jump to the SAME tap type in the other finish\n     (Brass Freestanding Mixer -> Black Freestanding Mixer).\n  2. \"Tap Type\" dropdown lists every tap in the CURRENT finish.\n  Only products whose product type contains \"Tap\" are listed, so showers and accessories in the\n  same range stay out of the dropdown.\n{%- endcomment -%}\n\n{%- if product.metafields.custom.range != blank -%}\n  {%- liquid\n    assign siblings = product.metafields.custom.range.value.products.value\n    assign cur_col = product.metafields.custom.colour_name.value | strip\n    assign cur_type = product.metafields.custom.size_name.value | strip\n    assign printed_cols = ''\n    assign col_count = 0\n    assign type_count = 0\n    for sib in siblings\n      assign sib_ptype = sib.type | downcase\n      unless sib_ptype contains 'tap'\n        continue\n      endunless\n      assign s_col = sib.metafields.custom.colour_name.value | strip\n      if s_col != blank\n        assign k = '||' | append: s_col | append: '||'\n        unless printed_cols contains k\n          assign printed_cols = printed_cols | append: k\n          assign col_count = col_count | plus: 1\n        endunless\n      endif\n      if s_col == cur_col\n        assign type_count = type_count | plus: 1\n      endif\n    endfor\n  -%}\n\n  <div class=\"tp-tap-picker\">\n\n    {%- if col_count > 1 -%}\n      <div>\n        <div class=\"tp-tap-picker__label\"><strong>Colour:</strong><span>{{ cur_col }}</span></div>\n        <ul class=\"tp-tap-swatches\" role=\"list\">\n          {%- assign shown_cols = '' -%}\n          {%- for sib in siblings -%}\n            {%- assign sib_ptype = sib.type | downcase -%}\n            {%- unless sib_ptype contains 'tap' -%}{%- continue -%}{%- endunless -%}\n            {%- assign s_col = sib.metafields.custom.colour_name.value | strip -%}\n            {%- if s_col == blank -%}{%- continue -%}{%- endif -%}\n            {%- assign k = '||' | append: s_col | append: '||' -%}\n            {%- if shown_cols contains k -%}{%- continue -%}{%- endif -%}\n            {%- assign shown_cols = shown_cols | append: k -%}\n\n            {%- assign target = sib -%}\n            {%- for t in siblings -%}\n              {%- assign t_col = t.metafields.custom.colour_name.value | strip -%}\n              {%- assign t_type = t.metafields.custom.size_name.value | strip -%}\n              {%- if t_col == s_col and t_type == cur_type -%}\n                {%- assign target = t -%}\n                {%- break -%}\n              {%- endif -%}\n            {%- endfor -%}\n\n            {%- assign hex = sib.metafields.custom.colour_hex.value | strip | default: '#cccccc' -%}\n            <li>\n              <a href=\"{{ target.url }}\"\n                 class=\"tp-tap-swatch{% if s_col == cur_col %} is-current{% endif %}\"\n                 title=\"{{ s_col | escape }}\"\n                 aria-label=\"Choose colour {{ s_col | escape }}\"\n                 {% if s_col == cur_col %}aria-current=\"page\"{% endif %}>\n                <span style=\"background-color: {{ hex | escape }};\"></span>\n              </a>\n            </li>\n          {%- endfor -%}\n        </ul>\n      </div>\n    {%- endif -%}\n\n    {%- if type_count > 1 -%}\n      <div class=\"tp-tap-type\">\n        <label for=\"tp-tap-type-{{ product.id }}\">Tap Type:</label>\n        <div class=\"tp-tap-type__wrap\">\n          <select id=\"tp-tap-type-{{ product.id }}\" onchange=\"if(this.value){window.location.href=this.value}\">\n            {%- assign shown_types = '' -%}\n            {%- for sib in siblings -%}\n              {%- assign sib_ptype = sib.type | downcase -%}\n              {%- unless sib_ptype contains 'tap' -%}{%- continue -%}{%- endunless -%}\n              {%- assign s_col = sib.metafields.custom.colour_name.value | strip -%}\n              {%- if s_col != cur_col -%}{%- continue -%}{%- endif -%}\n              {%- assign s_type = sib.metafields.custom.size_name.value | strip | default: sib.title -%}\n              {%- assign k = '||' | append: s_type | append: '||' -%}\n              {%- if shown_types contains k -%}{%- continue -%}{%- endif -%}\n              {%- assign shown_types = shown_types | append: k -%}\n              <option value=\"{{ sib.url }}\"{% if sib.id == product.id %} selected{% endif %}{% unless sib.available %} disabled{% endunless %}>\n                {{- s_type | escape -}}{% unless sib.available %} (sold out){% endunless %}\n              </option>\n            {%- endfor -%}\n          </select>\n        </div>\n      </div>\n    {%- endif -%}\n\n  </div>\n{%- endif -%}"
          }
