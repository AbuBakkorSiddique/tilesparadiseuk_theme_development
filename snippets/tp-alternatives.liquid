{%- comment -%}
  TP closest alternatives: shown under the Sold out button when a product has nothing in stock.
  Picks up to 3 in-stock products of the same kind (same product template and type) from the
  product's own collections, and ranks them by how close they are:
    price difference, plus a penalty when the colour differs (custom.tile_color / colour_name)
    and when the size differs (custom.size).
  Samples, pallet deals, job lots, bundles and fixing materials are never suggested.
  Collections with more than 400 products (e.g. "all tiles") are skipped as too broad.
{%- endcomment -%}
{%- unless product.available -%}
{%- liquid
  assign ta_tpl = product.template_suffix | default: ''
  assign ta_type = product.type | downcase
  assign ta_col = product.metafields.custom.tile_color.value | append: '' | strip | downcase
  if ta_col == ''
    assign ta_col = product.metafields.custom.colour_name.value | append: '' | strip | downcase
  endif
  assign ta_size = product.metafields.custom.size.value | append: '' | strip | downcase
  assign ta_price = product.price
  assign ta_pen_col = ta_price | times: 35 | divided_by: 100
  assign ta_pen_size = ta_price | times: 25 | divided_by: 100
  assign ta_skip = '|all|frontpage|sale|clearance|new-in|new-arrivals|best-sellers|samples|job-lot-deals|wholesale-pallet-deals|pallet-deals|'
  assign ta_bad = 'sample,pallet,job lot,deal,bundle,adhesive,grout,backer,levelling,delivery'
  assign ta_bad = ta_bad | split: ','
  assign ta_seen = '|'
  assign ta_list = ''
  assign ta_used = 0
  for c in product.collections
    if ta_used >= 6
      break
    endif
    if c.products_count < 2 or c.products_count > 400
      continue
    endif
    assign ta_key = '|' | append: c.handle | append: '|'
    if ta_skip contains ta_key
      continue
    endif
    assign ta_used = ta_used | plus: 1
    for p in c.products limit: 50
      if p.id == product.id
        continue
      endif
      unless p.available
        continue
      endunless
      assign p_tpl = p.template_suffix | default: ''
      if p_tpl != ta_tpl
        continue
      endif
      assign p_type = p.type | downcase
      if p_type != ta_type
        continue
      endif
      assign p_key = '|' | append: p.handle | append: '|'
      if ta_seen contains p_key
        continue
      endif
      assign ta_seen = ta_seen | append: p.handle | append: '|'
      assign p_title = p.title | downcase
      assign p_badw = false
      for w in ta_bad
        if p_title contains w
          assign p_badw = true
          break
        endif
      endfor
      if p_badw or p.tags contains 'Samples'
        continue
      endif
      assign p_score = p.price | minus: ta_price | abs
      if ta_col != ''
        assign p_col = p.metafields.custom.tile_color.value | append: '' | strip | downcase
        if p_col == ''
          assign p_col = p.metafields.custom.colour_name.value | append: '' | strip | downcase
        endif
        if p_col != ta_col
          assign p_score = p_score | plus: ta_pen_col
        endif
      endif
      if ta_size != ''
        assign p_size = p.metafields.custom.size.value | append: '' | strip | downcase
        if p_size != ta_size
          assign p_score = p_score | plus: ta_pen_size
        endif
      endif
      assign p_entry = p_score | plus: 1000000000 | append: ':' | append: p.handle
      assign ta_list = ta_list | append: p_entry | append: ','
    endfor
  endfor
  assign ta_sorted = ta_list | split: ',' | sort
-%}
{%- if ta_sorted.size > 0 -%}
  <div class="tp-alt">
    <div class="tp-alt__head">
      <span class="tp-alt__h">This one's sold out</span>
      <span class="tp-alt__sub">Here are the closest matches in stock now</span>
    </div>
    <div class="tp-alt__list">
      {%- for e in ta_sorted limit: 3 -%}
        {%- assign ah = e | split: ':' | last -%}
        {%- assign a = all_products[ah] -%}
        {%- if a == blank -%}{%- continue -%}{%- endif -%}
        {%- capture a_pm -%}{%- render 'tp-per-m', product: a -%}{%- endcapture -%}
        {%- liquid
          assign a_pm = a_pm | strip
          assign a_col = a.metafields.custom.tile_color.value | append: '' | strip | downcase
          if a_col == ''
            assign a_col = a.metafields.custom.colour_name.value | append: '' | strip | downcase
          endif
          assign a_size = a.metafields.custom.size.value | append: '' | strip | downcase
          assign a_chips = ''
          if ta_col != '' and a_col == ta_col
            assign a_chips = a_chips | append: 'Same colour'
          endif
          if ta_size != '' and a_size == ta_size
            if a_chips != ''
              assign a_chips = a_chips | append: ' · '
            endif
            assign a_chips = a_chips | append: 'Same size'
          endif
        -%}
        <a class="tp-alt__item" href="{{ a.url }}">
          <span class="tp-alt__img">
            {%- if a.featured_image -%}{{ a.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: a.title }}{%- endif -%}
          </span>
          <span class="tp-alt__txt">
            <span class="tp-alt__t">{{ a.title | truncate: 70 | escape }}</span>
            <span class="tp-alt__meta">
              <b>{{ a.price | money }}{% if a_pm == 'y' %}<small> /m²</small>{% endif %}</b>
              <em>In stock</em>
              {%- if a_chips != '' -%}<i>{{ a_chips }}</i>{%- endif -%}
            </span>
          </span>
          <span class="tp-alt__go" aria-hidden="true">&rarr;</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
  <style>
    .tp-alt{margin:16px 0 0;font-family:"Open Sans",sans-serif;border:1.5px solid #f2c94c;background:#fffbea;border-radius:12px;padding:12px;}
    .tp-alt__head{display:flex;flex-direction:column;gap:2px;margin-bottom:10px;}
    .tp-alt__h{font-size:14px;font-weight:800;color:#1a1d24;}
    .tp-alt__sub{font-size:12.5px;color:#4b5563;}
    .tp-alt__list{display:flex;flex-direction:column;gap:8px;}
    .tp-alt__item{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #eee3b8;border-radius:10px;padding:8px 10px;text-decoration:none;color:#1a1d24;}
    .tp-alt__item:hover{border-color:#1a1d24;}
    .tp-alt__img{flex:0 0 auto;width:56px;height:56px;border-radius:7px;overflow:hidden;background:#f4f4f4;}
    .tp-alt__img img{width:100%;height:100%;object-fit:cover;display:block;}
    .tp-alt__txt{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:3px;}
    .tp-alt__t{font-size:13px;font-weight:700;line-height:1.3;}
    .tp-alt__meta{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center;font-size:12px;}
    .tp-alt__meta b{font-size:13.5px;font-weight:800;}
    .tp-alt__meta small{font-size:11px;font-weight:600;color:#6b7280;}
    .tp-alt__meta em{font-style:normal;font-weight:700;color:#1f8a4c;}
    .tp-alt__meta i{font-style:normal;color:#6b7280;}
    .tp-alt__go{flex:0 0 auto;font-weight:800;color:#c8102e;font-size:18px;}
  </style>
{%- endif -%}
{%- endunless -%}